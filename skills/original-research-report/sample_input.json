    "period": "2025-10-01 to 2026-09-30",
    "unit": "account (a business with 150 or more bookings in the period)",
    "query": "WITH acct AS (SELECT account_id, industry, reminder_setting, deposit_policy, COUNT(*) AS bookings, COUNTIF(status = 'no_show') AS no_shows FROM `app_data.bookings` WHERE appointment_date BETWEEN '2025-10-01' AND '2026-09-30' GROUP BY account_id, industry, reminder_setting, deposit_policy HAVING COUNT(*) >= 150) SELECT 'all' AS dimension, 'all' AS value, COUNT(*) AS accounts, SUM(bookings) AS bookings, SUM(no_shows) AS no_shows, AVG(SAFE_DIVIDE(no_shows, bookings)) AS mean_rate, STDDEV_SAMP(SAFE_DIVIDE(no_shows, bookings)) AS sd_rate, SAFE_DIVIDE(MAX(bookings), SUM(bookings)) AS top_account_share FROM acct UNION ALL SELECT 'reminders', reminder_setting, COUNT(*), SUM(bookings), SUM(no_shows), AVG(SAFE_DIVIDE(no_shows, bookings)), STDDEV_SAMP(SAFE_DIVIDE(no_shows, bookings)), SAFE_DIVIDE(MAX(bookings), SUM(bookings)) FROM acct GROUP BY reminder_setting HAVING COUNT(*) >= 10 UNION ALL SELECT 'deposit', deposit_policy, ... GROUP BY deposit_policy HAVING COUNT(*) >= 10 UNION ALL SELECT 'industry', industry, ... GROUP BY industry HAVING COUNT(*) >= 10 UNION ALL SELECT 'industry x deposit', CONCAT(industry, ' / ', deposit_policy), ... GROUP BY industry, deposit_policy HAVING COUNT(*) >= 10",
