{
  "run_date": "2026-10-28",
  "request": "Write a press release for our new Waitlist Autofill feature, going live Tuesday Nov. 10. Also mention we passed 12,000 customers, that we hired a CFO, and our new logo. Check our numbers before it goes out.",
  "business": {
    "name": "Example Booking Software",
    "what_it_sells": "online booking, reminders and payments for salons, clinics, studios and personal trainers",
    "audience": "owners and front-desk managers of small service businesses with 1 to 20 staff, mostly in the US, UK and Canada",
    "site": "https://www.example.com",
    "headquarters": "New York, N.Y.",
    "founded": 2019,
    "markets": [
      "U.S.",
      "U.K.",
      "Canada"
    ],
    "plans_with_feature": [
      "Growth",
      "Business"
    ],
    "time_zone": "America/New_York"
  },
  "items_in_the_brief": [
    {
      "id": "N1",
      "item": "Waitlist Autofill launch: when a client cancels, the slot is offered by text and email to the waitlist, and the first to accept is booked",
      "date": "2026-11-10",
      "details": [
        "offers go out by text and email to clients on that day's waitlist, in the order they joined it",
        "the first client to accept is booked; the others are told the slot is taken; the change shows in the business's calendar",
        "owners set how far ahead a slot can be offered and can require a deposit to accept it",
        "clients join a waitlist from the business's booking page when the time they want is full",
        "works with the existing reminders, deposits and two-way calendar sync",
        "clients need no app: offers arrive by text and email and are accepted with one tap",
        "included in the Growth and Business plans at no extra cost; not on Starter",
        "businesses switch it on in their booking settings"
      ]
    },
    {
      "id": "N2",
      "item": "Passed 12,000 customer businesses",
      "date": "2026-10-01"
    },
    {
      "id": "N3",
      "item": "New CFO, Owen Hartsell, joined from a payments company",
      "date": "2026-10-19"
    },
    {
      "id": "N4",
      "item": "Refreshed logo and brand colors",
      "date": "2026-10-20"
    }
  ],
  "claims": [
    {
      "id": "C1",
      "text": "Over 12,000 businesses run their bookings on Example Booking Software",
      "source_named_by_user": "billing dashboard, active paying accounts on 2026-10-01"
    },
    {
      "id": "C2",
      "text": "Bookings through our booking pages tripled in the past year",
      "source_named_by_user": "GA4"
    },
    {
      "id": "C3",
      "text": "In our pilot with 50 businesses, Autofill refilled 41% of canceled appointments",
      "source_named_by_user": "pilot results sheet"
    },
    {
      "id": "C4",
      "text": "The first booking app to refill canceled appointments automatically",
      "source_named_by_user": null
    },
    {
      "id": "C5",
      "text": "More than 1 million appointments were booked through our pages in the last 12 months",
      "source_named_by_user": "GA4"
    },
    {
      "id": "C6",
      "text": "Salons never lose money to a no-show again (from the draft CEO quote)",
      "source_named_by_user": null
    }
  ],
  "draft_quotes": [
