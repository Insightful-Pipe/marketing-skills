  "decision": {
    "step": "Rename + new domain",
    "one_line": "Rename to Agendaly and move to agendaly.example: 42.9% of new customers in the last 4 quarters came from outside salons, and that share is growing, so the name now misdescribes the business. Keep 'Agendaly, formerly SalonSlate' on every channel for 6 months.",
    "ladder": [
      "Keep",
      "Refresh",
      "Reposition",
      "Rename",
      "Rename + new domain"
    ],
    "reasons": [
      {
        "reason": "The name says salons, but we now sell to clinics and fitness studios too",
        "type": "the name no longer says what you sell",
        "highest_step": "Rename",
        "evidence_test": "30% or more of new customers from outside what the name says, and growing",
        "evidence": "893 of 2,080 new customers in 4 quarters (42.9%) were clinics or fitness studios; the share grew from 33.0% in 2025-Q4 to 51.1% in 2026-Q3",
        "result": "holds"
      },
      {
        "reason": "The logo looks dated and differs between the app, the site and the socials",
        "type": "the look is dated or inconsistent",
        "highest_step": "Refresh",
        "evidence_test": "mixed logos, colours or names across channels",
        "evidence": "user: three logo versions in use (app icon 2021, site 2023, socials 2024)",
        "result": "holds (user's evidence; logos can't be read through a connector)"
      },
      {
        "reason": "Our new CEO wants a fresh start",
        "type": "new leadership",
        "highest_step": "Keep",
        "evidence_test": "none: not a reason a customer sees",
        "evidence": "none given",
        "result": "doesn't count"
      }
    ],
    "brand_dependence": {
      "branded_clicks_8_weeks": 8825,
      "all_organic_clicks_8_weeks": 28069,
      "share": 31.4,
      "band": "medium",
      "math": "8,825 branded clicks / 28,069 organic clicks = 31.4% (medium: 15% to 40%)"
    },
    "bridge_period_months": 6,
    "what_the_rename_puts_at_risk": "about 1,103 branded clicks a week from Google, 76 from Bing, and the 1,474 direct sessions a week that partly ride on the old name"
  },
