  "ranked_fixes": [
    {
      "fix": "Block sort and filter parameter URLs in robots.txt",
      "do": "Add Disallow: /*?*sort=, Disallow: /*?*color=, Disallow: /*?*size=, Disallow: /*?*price= under User-agent: *. Keep ?page= crawlable. Stop linking sort options as plain links where the theme allows.",
      "hits_a_week": 779,
      "evidence": "779 verified Googlebot and Bingbot hits on parameter URLs in 7 days; top parameters sort (480), color (257), size (178), price (42); robots.txt disallows none of them.",
      "who": "do this in robots.txt",
      "rank": 1
    },
    {
      "fix": "Block the stock api in robots.txt",
      "do": "Check first that product pages don't need /api/stock to render their main content (URL Inspection, view the rendered page). If they don't, add Disallow: /api/ under User-agent: *.",
      "hits_a_week": 136,
      "evidence": "136 verified search-bot hits on /api/stock URLs, all answered 200.",
      "who": "do this in robots.txt",
      "rank": 2
    },
    {
      "fix": "Link straight to final URLs and collapse the collections chain",
      "do": "Point internal links and feeds at /p/<slug>/ with the trailing slash, and send each old /collections/<slug> URL straight to its /c/<slug>/ page in one hop.",
      "hits_a_week": 125,
      "evidence": "125 verified search-bot hits answered 301: 77 on 40 product URLs missing the trailing slash and 48 on old /collections/ and /c/<slug>-old/ category URLs. Of the top 5 redirects traced, 1 is a 2-hop chain.",
      "who": "do this in your CMS and redirect rules",
      "rank": 3
    },
    {
      "fix": "Consolidate or block tag pages that earn no clicks",
      "do": "Merge thin tag pages into stronger pages on the same topic and take them out of the sitemap, or Disallow them if they shouldn't be crawled at all. Don't noindex them to save crawl.",
      "hits_a_week": 122,
