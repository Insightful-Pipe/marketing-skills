      "ratio": "1%",
      "country": "US",
      "job": "the next lookalike test once the list matches 1,000+ people",
      "note": "Don't run it next to the purchasers 1% lookalike in parallel ad sets."
    },
    {
      "order": 7,
      "stage": "3: when one ad set gets 50+ purchases a week",
      "name": "LAL | List | Value-based buyers | 1% | US",
      "source": "the customer list with order values",
      "job": "value-based lookalike for scale",
      "unlocks_when": "a purchase ad set reaches 50 purchases a week"
    }
