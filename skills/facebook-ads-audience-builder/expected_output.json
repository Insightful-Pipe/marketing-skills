      "window_days": 365,
      "job": "warm tier"
    },
    {
      "order": 5,
      "stage": "2: now",
      "name": "EXCL | List | All customers",
      "source": "customer list upload: email, phone, first and last name, country",
      "rule": "everyone who has paid",
      "refresh": "monthly",
      "job": "exclude from prospecting; lookalike seed"
    },
    {
      "order": 6,
      "stage": "2: now",
      "name": "LAL | List | High-value customers | 1% | US",
      "source": "customer list segment: top 25% by lifetime value, with a value column",
