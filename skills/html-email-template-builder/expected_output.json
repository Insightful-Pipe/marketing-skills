{
  "header": {
    "mode": "build",
    "email_job": "marketing: a feature announcement to existing customers",
    "platform": "Klaviyo",
    "subject": "New: take a deposit when clients book",
    "brand_source": "https://www.example.com/ read with the crawler's brand-extractor on 2026-10-28, logo PNG from the user"
  },
  "brand_kit": [
    {
      "item": "Button colour",
      "source": "brand-extractor primaryButton.background",
      "site_value": "#3B82F6",
      "email_value": "#3472D8",
      "why": "white text on #3B82F6 is 3.67:1, under 4.5:1; darkened 12% to reach 4.62:1"
    },
    {
      "item": "Link colour",
      "source": "brand-extractor colors.primary",
      "site_value": "#3B82F6",
      "email_value": "#3370D4",
      "why": "#3B82F6 on the card background is 3.52:1; darkened 14% to reach 4.56:1"
    },
    {
      "item": "Button text",
      "source": "brand-extractor primaryButton.textColor",
      "site_value": "#FFFFFF",
      "email_value": "#FFFFFF",
      "why": "kept"
    },
    {
      "item": "Corner radius",
      "source": "brand-extractor primaryButton.borderRadius",
      "site_value": "6px",
      "email_value": "6px",
      "why": "rounded, so the button gets a VML shape for classic Outlook"
    },
    {
      "item": "Text colour",
      "source": "brand-extractor colors.text",
      "site_value": "#1F2937",
      "email_value": "#1F2937",
      "why": "14.06:1 on the card background"
    },
    {
      "item": "Card background",
      "source": "brand-extractor colors.background",
      "site_value": "#FFFFFF",
      "email_value": "#FAFAFA",
      "why": "near-white instead of pure white, so forced dark-mode inversion is gentler"
    },
    {
      "item": "Heading font",
      "source": "brand-extractor typography.heading",
      "site_value": "Sora",
      "email_value": "Sora, 'Segoe UI', Helvetica, Arial, sans-serif",
      "why": "web font loads only in Apple Mail, iOS Mail and some Android apps; the link is hidden from Outlook and the stack falls back to system fonts"
    },
    {
      "item": "Body font",
      "source": "brand-extractor typography.body",
      "site_value": "ui-sans-serif",
      "email_value": "'Segoe UI', Helvetica, Arial, sans-serif",
      "why": "a CSS generic, not a brand font, so a safe stack is used"
    },
    {
      "item": "Body size",
      "source": "brand-extractor typography.sizes.body",
      "site_value": "18px",
      "email_value": "16px / 24px line height",
      "why": "email body size, not the site's"
    },
    {
      "item": "Logo",
      "source": "user (PNG)",
      "site_value": "https://www.example.com/assets/logo.svg",
      "email_value": "https://www.example.com/email/logo-dark@2x.png at 160 x 38",
      "why": "the site logo is an SVG, which Gmail and classic Outlook don't show; ogImage is a social banner, not the logo"
    },
    {
      "item": "Ignored",
      "source": "brand-extractor secondaryButton",
      "site_value": "FAQ accordion row read as a button",
      "email_value": "not used",
      "why": "secondaryButton and buttons[] can pick up page components"
    }
  ],
  "account_read": {
    "sender": "Example Booking Software <hello@example.com>",
    "postal_address_set": true,
    "what_it_means": "the {{ organization.full_address }} tag will print the address, so the footer uses the tag",
    "templates": [
      {
        "id": "TmPl01",
        "name": "Monthly product update",
        "editor_type": "USER_DRAGGABLE",
        "unsubscribe_tag": true,
        "address_tag": false,
        "lang": false,
        "role_presentation": false,
        "svg_image": true,
        "plain_text": false
      },
      {
        "id": "TmPl02",
        "name": "test template",
        "editor_type": "CODE",
        "unsubscribe_tag": false,
        "address_tag": false,
        "lang": false,
        "role_presentation": false,
        "svg_image": false,
        "plain_text": false
      }
    ],
    "template_finding": "'Monthly product update' lacks an address tag, lang, role attributes, uses an SVG logo; 'test template' lacks an unsubscribe tag, an address tag, lang, role attributes. No template carries both footer tags, so the new email carries its own footer."
  },
  "block_plan": [
    "preheader (hidden, empty for Klaviyo)",
    "header: logo on a white pill, View in browser",
    "hero image 600 x 300",
    "headline (h1)",
    "intro paragraph",
    "button: Turn on deposits",
    "two cards side by side (256px + 24px gap + 256px = the 536px inside the padding), stacking under 620px",
    "secondary link and sign-off",
    "footer: reason, address tag, Manage preferences, Unsubscribe"
  ],
  "html": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>New: take a deposit when clients book</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<!--[if !mso]><!--><link href=\"https://fonts.googleapis.com/css2?family=Sora:wght@600&display=swap\" rel=\"stylesheet\"><!--<![endif]-->\n<style>a{color:#3370D4;}@media only screen and (max-width:620px){.eb-col{max-width:100%!important;width:100%!important;display:block!important;}.eb-gap{display:block!important;width:100%!important;height:16px!important;}.eb-pad{padding-left:20px!important;padding-right:20px!important;}}@media (prefers-color-scheme: dark){.eb-page{background-color:#0B1220!important;}.eb-card{background-color:#111827!important;}.eb-soft{background-color:#1E293B!important;}.eb-text{color:#F3F4F6!important;}.eb-muted{color:#CBD5E1!important;}.eb-link{color:#93C5FD!important;}.eb-logo-pill{background-color:#FFFFFF!important;}}[data-ogsb] .eb-page{background-color:#0B1220!important;}[data-ogsb] .eb-card{background-color:#111827!important;}[data-ogsb] .eb-soft{background-color:#1E293B!important;}[data-ogsc] .eb-text{color:#F3F4F6!important;}[data-ogsc] .eb-muted{color:#CBD5E1!important;}[data-ogsc] .eb-link{color:#93C5FD!important;}</style>\n</head>\n<body class=\"eb-page\" style=\"margin:0;padding:0;background-color:#F3F4F6;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>\n<table role=\"presentation\" class=\"eb-page\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F3F4F6;\"><tr><td align=\"center\" style=\"padding:24px 0;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" class=\"eb-card\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FAFAFA;\">\n<tr><td class=\"eb-pad\" style=\"padding:20px 32px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td valign=\"middle\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td class=\"eb-logo-pill\" style=\"padding:6px 10px;background-color:#FFFFFF;border-radius:6px;\"><a href=\"https://www.example.com/\"><img src=\"https://www.example.com/email/logo-dark@2x.png\" width=\"160\" height=\"38\" alt=\"Example Booking Software\" border=\"0\" style=\"display:block;width:160px;height:38px;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:14px;color:#1F2937;\"></a></td></tr></table></td><td align=\"right\" valign=\"middle\"><a class=\"eb-muted\" href=\"{% web_view_link %}\" style=\"font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;color:#4B5563;text-decoration:underline;\">View in browser</a></td></tr></table></td></tr>\n<tr><td style=\"padding:0;\"><img class=\"eb-text\" src=\"https://www.example.com/email/deposits-hero@2x.png\" width=\"600\" alt=\"Booking page with a deposit step before the confirm button\" border=\"0\" style=\"display:block;width:100%;max-width:600px;height:auto;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;color:#1F2937;\"></td></tr>\n<tr><td class=\"eb-pad\" style=\"padding:32px 32px 32px 32px;\"><h1 class=\"eb-text\" style=\"margin:0 0 16px 0;font-family:Sora, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:28px;line-height:36px;font-weight:600;color:#1F2937;\">Take a deposit when clients book</h1><p class=\"eb-text\" style=\"margin:0 0 24px 0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1F2937;\">Deposits are now part of your booking page. Ask for a fixed amount or a share of the price, and the money is in your account before the client walks in.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" bgcolor=\"#3472D8\" style=\"background-color:#3472D8;border-radius:6px;\"><!--[if mso]><v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://www.example.com/features/payments/\" style=\"height:48px;v-text-anchor:middle;width:220px;\" arcsize=\"12%\" stroke=\"f\" fillcolor=\"#3472D8\"><w:anchorlock/><center style=\"color:#FFFFFF;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;\">Turn on deposits</center></v:roundrect><![endif]--><!--[if !mso]><!--><a href=\"https://www.example.com/features/payments/\" style=\"display:inline-block;padding:14px 28px;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;background-color:#3472D8;border-radius:6px;\">Turn on deposits</a><!--<![endif]--></td></tr></table></td></tr>\n<tr><td class=\"eb-pad\" style=\"padding:0 32px 8px 32px;font-size:0;\"><!--[if mso]><table role=\"presentation\" width=\"536\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td width=\"256\" valign=\"top\"><![endif]--><div class=\"eb-col\" style=\"display:inline-block;width:100%;max-width:256px;vertical-align:top;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td class=\"eb-soft\" style=\"padding:20px;background-color:#EFF6FF;border-radius:6px;\"><h2 class=\"eb-text\" style=\"margin:0 0 8px 0;font-family:Sora, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:18px;line-height:26px;color:#1F2937;\">Fewer no-shows</h2><p class=\"eb-text\" style=\"margin:0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1F2937;\">Clients who pay a deposit are far more likely to turn up, and you keep the deposit if they don't.</p></td></tr></table></div><!--[if mso]></td><td width=\"24\" style=\"width:24px;\">&nbsp;</td><td width=\"256\" valign=\"top\"><![endif]--><!--[if !mso]><!--><div class=\"eb-gap\" style=\"display:inline-block;width:24px;font-size:0;line-height:0;\">&nbsp;</div><!--<![endif]--><div class=\"eb-col\" style=\"display:inline-block;width:100%;max-width:256px;vertical-align:top;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td class=\"eb-soft\" style=\"padding:20px;background-color:#EFF6FF;border-radius:6px;\"><h2 class=\"eb-text\" style=\"margin:0 0 8px 0;font-family:Sora, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:18px;line-height:26px;color:#1F2937;\">Your rules</h2><p class=\"eb-text\" style=\"margin:0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1F2937;\">Choose which services need a deposit, how much, and how late a client can cancel for a refund.</p></td></tr></table></div><!--[if mso]></td></tr></table><![endif]--></td></tr>\n<tr><td class=\"eb-pad\" style=\"padding:24px 32px 32px 32px;\"><p class=\"eb-text\" style=\"margin:0 0 16px 0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1F2937;\"><a class=\"eb-link\" href=\"https://www.example.com/blog/deposit-policy/\" style=\"color:#3370D4;text-decoration:underline;\">Read the deposit policy guide</a></p><p class=\"eb-text\" style=\"margin:0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1F2937;\">The Example Booking Software team</p></td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;\"><tr><td class=\"eb-pad\" style=\"padding:24px 32px;\"><p class=\"eb-muted\" style=\"margin:0 0 16px 0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;color:#4B5563;\">You're getting this email because you have an Example Booking Software account.</p><p class=\"eb-muted\" style=\"margin:0 0 16px 0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;color:#4B5563;\">Example Booking Software, {{ organization.full_address }}</p><p class=\"eb-muted\" style=\"margin:0;font-family:'Segoe UI', Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;color:#4B5563;\"><a class=\"eb-muted\" href=\"{% manage_preferences_link %}\" style=\"color:#4B5563;text-decoration:underline;\">Manage preferences</a> &nbsp;|&nbsp; <a class=\"eb-muted\" href=\"{% unsubscribe_link %}\" style=\"color:#4B5563;text-decoration:underline;\">Unsubscribe</a></p></td></tr></table>\n</td></tr></table>\n</body>\n</html>",
  "plain_text": "View in browser: {% web_view_link %}\n\nTake a deposit when clients book\n\nDeposits are now part of your booking page. Ask for a fixed amount or a share\nof the price, and the money is in your account before the client walks in.\n\nTurn on deposits: https://www.example.com/features/payments/\n\nFewer no-shows\nClients who pay a deposit are far more likely to turn up, and you keep the\ndeposit if they don't.\n\nYour rules\nChoose which services need a deposit, how much, and how late a client can\ncancel for a refund.\n\nRead the deposit policy guide: https://www.example.com/blog/deposit-policy/\n\nThe Example Booking Software team\nExample Booking Software: https://www.example.com/\n\n---\nYou're getting this email because you have an Example Booking Software\naccount.\nExample Booking Software, {{ organization.full_address }}\nManage preferences: {% manage_preferences_link %}\nUnsubscribe: {% unsubscribe_link %}",
