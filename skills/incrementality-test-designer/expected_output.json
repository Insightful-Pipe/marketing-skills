  "test_plan": {
    "phases": [
      {
        "phase": "Freeze, tracking and ratio check",
        "dates": "2026-10-06 to 2026-10-18",
        "what": "No edits to scope campaigns. Tracking check: confirm intake records log every lead's location the same way in the holdout and control metros, with no form, call-tracking or intake change planned before the read. The 2026-10-01 budget edits hit every metro alike, so they should leave the holdout/control ratio alone; confirm the two full weeks after it (2026-10-05 to 2026-10-18) stay within the back-test error."
      },
      {
        "phase": "Launch",
        "dates": "2026-10-19",
        "what": "Add the exclusions and the budget trims before 00:00 account time (Monday)."
      },
      {
        "phase": "Carry-over skipped",
        "dates": "2026-10-19 (1 day)",
        "what": "Leave the first 1 day out of the read: clicks from before the switch still convert."
      },
      {
        "phase": "Test",
        "dates": "2026-10-19 to 2026-12-13",
        "what": "8 full weeks. Daily check for the first 3 days that holdout spend drops to near zero."
      },
      {
        "phase": "Restore",
        "dates": "2026-12-14",
        "what": "Remove the exclusions in Google Ads and restore the daily budgets."
      },
      {
        "phase": "Read",
        "dates": "2026-12-15",
        "what": "Wait 1 day for late conversions, then read intake records by metro."
      }
    ],
    "guardrails": [
      "Start on a Monday and run whole weeks (Monday carries 23% of scope conversions, Sunday 8%).",
      "Before launch, check that intake records capture each lead's location the same way in every holdout and control metro; a test on uneven tracking can't be read.",
      "Freeze bids, budgets, keywords, ads and targeting in the scope campaigns from now until the test ends.",
      "Trim each scope budget by its holdout share on launch day so the money doesn't move into control metros.",
      "For the first 3 days, rerun Q4 over the days since launch and check that holdout spend is near zero; fix the exclusions before counting any days.",
      "Log outside events (news, competitor moves, outages) with dates. Stop early only for a broken setup."
    ],
    "cost": {
      "spend_paused": 2290,
      "attributed_conversions_at_risk_if_all_incremental": 77.7
    },
    "risks": [
      {
        "risk": "Thanksgiving (2026-11-26) falls inside the test",
        "fix": "It hits every metro alike, so the ratio should absorb it; log it and report the read with and without that week."
      },
      {
        "risk": "Budget flowing from the holdout into control metros",
        "fix": "Trim each scope budget by its holdout share on launch day (payloads below)."
      },
      {
        "risk": "Out-of-scope campaigns serve in the holdout",
        "fix": "Brand stays on everywhere by design; the paused campaign stays paused, and the out-of-state campaigns' spend there is small. Keep both unchanged and read total intake, not campaign conversions."
      },
      {
        "risk": "Sized on Google Ads conversions, not intake records",
        "fix": "Pull 16 weeks of intake by metro before launch and rerun the sizing; if the floor moves above 60%, drop the test or raise the spend cap: it already runs the 8-week maximum."
      },
      {
        "risk": "Pressure to stop early",
        "fix": "The decision rule below is agreed now; the test runs its full length."
      }
