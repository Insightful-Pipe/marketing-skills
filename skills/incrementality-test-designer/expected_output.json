  "test_plan": {
    "phases": [
      {
        "phase": "Freeze, tracking and ratio check",
        "dates": "2026-10-21 to 2026-11-01",
        "what": "No edits to scope campaigns. Tracking check: confirm booking records log every job's service address the same way in the holdout and control metros, with no form, call-tracking or booking change planned before the read. The 2026-10-12 budget edits hit every metro alike, so they should leave the holdout/control ratio alone; confirm the two full weeks after it (2026-10-19 to 2026-11-01) stay within the back-test error."
      },
      {
        "phase": "Launch",
        "dates": "2026-11-02",
        "what": "Add the exclusions and the budget trims before 00:00 account time (Monday)."
      },
      {
        "phase": "Carry-over skipped",
        "dates": "2026-11-02 to 2026-11-05",
        "what": "Leave the first 4 days out of the read: clicks from before the switch still convert."
      },
      {
        "phase": "Test",
        "dates": "2026-11-02 to 2026-11-29",
        "what": "4 full weeks. Daily check for the first 3 days that holdout spend drops to near zero."
      },
      {
        "phase": "Restore",
        "dates": "2026-11-30",
        "what": "Remove the exclusions in Google Ads and restore the daily budgets."
      },
      {
        "phase": "Read",
        "dates": "2026-12-04",
        "what": "Wait 4 days for late conversions, then read booking records by metro."
      }
    ],
    "guardrails": [
      "Start on a Monday and run whole weeks (Monday carries 17% of scope conversions, Sunday 11%).",
      "Before launch, check that booking records capture each job's service address the same way in every holdout and control metro; a test on uneven tracking can't be read.",
      "Freeze bids, budgets, keywords, ads and targeting in the scope campaigns from now until the test ends.",
      "Trim each scope budget by its holdout share on launch day so the money doesn't move into control metros.",
      "For the first 3 days, rerun Q4 over the days since launch and check that holdout spend is near zero; fix the exclusions before counting any days.",
      "Log outside events (news, competitor moves, outages) with dates. Stop early only for a broken setup."
    ],
