  "dns_check": [
    {
      "domain": "example.com",
      "role": "main domain",
      "records": [
        {
          "record": "SPF",
          "found": "v=spf1 include:_spf.google.com ~all | v=spf1 include:mail.newsletter-tool.example ~all",
          "result": "fail",
          "why": "2 SPF records at one name; receivers return a permanent error and SPF fails for all mail",
          "fix": "replace both with one record: v=spf1 include:_spf.google.com include:mail.newsletter-tool.example ~all",
          "lookups_after_fix": 2
        },
        {
          "record": "DKIM",
          "name": "google._domainkey.example.com",
          "found": "v=DKIM1; k=rsa; p=<392 characters>",
          "key_bytes": 294,
          "key_bits": 2048,
          "result": "pass",
          "why": "2048-bit key"
        },
        {
          "record": "DMARC",
          "found": "v=DMARC1; p=quarantine; rua=mailto:dmarc@example.com",
          "result": "pass",
          "why": "p=quarantine with reports"
        },
        {
          "record": "MX",
          "found": "1 smtp.google.com.",
          "result": "pass",
          "why": "points to Google Workspace"
        }
      ],
      "tally": {
        "pass": 3,
        "warn": 0,
        "fail": 1
      },
      "owner_note": "Main-domain fixes affect marketing and transactional mail; hand them to whoever owns that mail (email-deliverability-auditor, if installed)."
    },
    {
      "domain": "examplebookingmail.example",
      "role": "cold domain",
      "records": [
        {
          "record": "SPF",
          "found": "v=spf1 include:_spf.google.com include:spf.protection.outlook.com ~all",
          "result": "warn",
          "why": "include:spf.protection.outlook.com authorizes Microsoft 365, which this domain doesn't use, and spends a lookup",
          "lookups": 2,
          "fix": "v=spf1 include:_spf.google.com ~all",
          "lookups_after_fix": 1
        },
        {
          "record": "DKIM",
          "name": "google._domainkey.examplebookingmail.example",
          "found": "v=DKIM1; k=rsa; p=<216 characters>",
          "key_bytes": 162,
          "key_bits": 1024,
          "result": "warn",
          "why": "1024-bit key; Google recommends 2048",
          "fix": "generate a new 2048-bit key in the Google Admin console (Apps, Gmail, Authenticate email), publish it, then start authentication again"
        },
        {
          "record": "DMARC",
          "found": "v=DMARC1; p=none",
          "result": "warn",
          "why": "no rua=, so nobody sees authentication failures",
          "fix": "v=DMARC1; p=none; rua=mailto:dmarc-reports@examplebookingmail.example",
          "note": "p=none is the accepted minimum; move to p=quarantine once reports show the cold mail passing"
        },
        {
          "record": "MX",
          "found": "1 smtp.google.com.",
          "result": "pass",
          "why": "points to Google Workspace"
        },
        {
          "record": "Tracking",
          "found": "track.examplebookingmail.example CNAME track.sendtool.example.",
          "result": "pass",
          "why": "custom tracking domain on the cold domain"
        }
      ],
      "tally": {
        "pass": 2,
        "warn": 3,
        "fail": 0
      }
    },
    {
      "domain": "bookwithexample.example",
      "role": "cold domain",
      "records": [
        {
          "record": "SPF",
          "found": "v=spf1 include: _spf.google.com -all",
          "result": "fail",
          "why": "a space after the colon breaks the include",
          "fix": "v=spf1 include:_spf.google.com -all"
        },
        {
          "record": "DKIM",
          "name": "google._domainkey.bookwithexample.example",
          "found": "v=DKIM1; k=rsa; p=<392 characters>",
          "key_bytes": 294,
          "key_bits": 2048,
          "result": "pass",
          "why": "2048-bit key"
        },
        {
          "record": "DMARC",
          "found": "v=DMARC1; p=none; rua=mailto:dmarc-reports@example.com",
          "result": "warn",
          "why": "reports go to example.com; bookwithexample.example._report._dmarc.example.com is missing, so receivers drop the reports",
          "fix": "add TXT bookwithexample.example._report._dmarc.example.com with value v=DMARC1",
          "note": "p=none is the accepted minimum; move to p=quarantine once reports show the cold mail passing"
        },
        {
          "record": "MX",
          "found": "(none)",
          "result": "fail",
          "why": "replies and bounce notices can't arrive",
          "fix": "MX 1 smtp.google.com."
        },
        {
          "record": "Tracking",
          "found": "the sending tool's shared tracking domain is in use",
          "result": "warn",
          "why": "click tracking runs on the sending tool's shared tracking domain",
          "fix": "turn click tracking off, or add CNAME track.bookwithexample.example pointing to the tracking host the sending tool gives"
        }
      ],
      "tally": {
        "pass": 1,
        "warn": 2,
        "fail": 2
      }
    }
  ],
