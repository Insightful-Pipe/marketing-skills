  "stop_rules": [
    {
      "signal": "Spam rate (Postmaster Tools, per domain)",
      "level": "0.1% or more",
      "action": "hold: halve that domain's volume, no ramp step, and look again at who is on the list and what the email says",
      "basis": "provider rule (Gmail's recommended limit for bulk senders)"
    },
    {
      "signal": "Spam rate",
      "level": "0.3% or more",
      "action": "stop the domain; swap in the spare",
      "basis": "provider rule (Gmail and Yahoo bulk-sender limit)"
    },
    {
      "signal": "Authentication rejection (Outlook.com 550 5.7.515, Gmail 5.7.26)",
      "level": "any",
      "action": "stop the domain until SPF, DKIM and DMARC pass",
      "basis": "provider rule (Microsoft and Google sender requirements)"
    },
    {
      "signal": "Hard bounce rate, per mailbox per week",
      "level": "1% or more",
      "action": "hold the ramp",
      "basis": "practitioner convention"
    },
    {
      "signal": "Hard bounce rate",
      "level": "2% or more",
      "action": "pause the mailbox; run its unsent contacts through verification again before it resumes",
      "basis": "practitioner convention"
    },
    {
      "signal": "Domain listed on a blocklist that receivers check (for example Spamhaus DBL)",
      "level": "any",
      "action": "stop the domain; swap in the spare",
      "basis": "practitioner convention"
    },
    {
      "signal": "Mailbox locked or suspended by the host",
      "level": "any",
      "action": "stop the mailbox; find out why",
      "basis": "host's terms"
    }
  ],
