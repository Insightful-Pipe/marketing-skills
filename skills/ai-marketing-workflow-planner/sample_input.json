        "klaviyo: get_campaign_report",
        "HubSpot (no connector): pipeline export"
      ],
      "writes": [],
      "produces": "a report for the leadership meeting",
      "reaches": "internal"
    },
    {
      "id": "T4",
      "task": "Review Google Ads search terms and add negative keywords",
      "owner": "Leo Park",
      "cadence": "weekly",
      "reads": [
        "google-ads: search_terms_report"
      ],
      "writes": [
        "google-ads: add_negative_keywords"
      ],
      "produces": "negative keywords added to campaigns",
      "reaches": "changes an ad account"
    },
    {
      "id": "T5",
      "task": "Review Meta ad results and pause tired ads",
      "owner": "Leo Park",
      "cadence": "weekly",
      "reads": [
        "facebook-ads: get_insights_ad"
      ],
      "writes": [
        "facebook-ads: update_ad"
      ],
      "produces": "paused ads and a note of why",
      "reaches": "changes an ad account"
    },
    {
      "id": "T6",
      "task": "Draft and schedule LinkedIn and X posts",
      "owner": "Nina Alvarez",
      "cadence": "3x weekly",
      "reads": [
        "google-sheets: query_sheet_data"
      ],
      "writes": [
        "social-media-scheduler: schedule_linkedin_post",
        "social-media-scheduler: schedule_x_post"
      ],
      "produces": "posts on the company LinkedIn page and X profile",
      "reaches": "public"
    },
    {
      "id": "T7",
      "task": "Write one blog post from the content calendar",
      "owner": "Nina Alvarez",
      "cadence": "weekly",
      "reads": [
        "google-search-console: search_analytics",
        "google-sheets: query_sheet_data"
      ],
      "writes": [
        "wordpress: create_post"
      ],
      "produces": "a published blog post",
      "reaches": "public"
    },
    {
      "id": "T8",
      "task": "Build the weekly customer newsletter in Klaviyo",
