  "task_list": [
    {
      "id": "T1",
      "task": "Build the weekly paid media report (Google Ads, Meta, LinkedIn Ads)",
      "owner": "Leo Park",
      "cadence": "weekly",
      "reads": [
        "google-ads: gaql",
        "facebook-ads: get_insights_adaccount",
        "linkedin-ads: get_account_analytics"
      ],
      "writes": [
        "google-sheets: update_cells",
        "slack: post_message"
      ],
      "produces": "a tab in the marketing ops sheet and a summary in #marketing",
      "reaches": "internal"
    },
    {
      "id": "T2",
      "task": "Check daily spend pacing on Google Ads, Meta and LinkedIn Ads",
      "owner": "Leo Park",
      "cadence": "daily",
      "reads": [
        "google-ads: gaql",
        "facebook-ads: get_insights_adaccount",
        "linkedin-ads: get_account_analytics"
      ],
      "writes": [
        "slack: post_message"
      ],
      "produces": "a message in #marketing when a platform is outside the pacing band",
      "reaches": "internal"
    },
    {
      "id": "T3",
      "task": "Write the monthly marketing report for leadership",
      "owner": "Dana Whitfield",
      "cadence": "monthly",
      "reads": [
        "google-analytics: get_report",
        "google-ads: gaql",
        "facebook-ads: get_insights_adaccount",
