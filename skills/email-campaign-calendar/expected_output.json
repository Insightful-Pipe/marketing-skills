  "frequency_test": {
    "arms": "control 2 a week, test 2.5 a week (the next level up failed only the unsubscribe line, not complaints)",
    "split": "50/50 of the active tier by the last digit of the profile id (0 to 4 control, 5 to 9 test), fixed for the whole test",
    "dates": "2027-01-04 to 2027-02-28 (8 weeks)",
    "extra_sends": "test arm only, on Saturday (third most used send day) in weeks 1, 3, 5 and 7: 2027-01-09, 2027-01-23, 2027-02-06, 2027-02-20",
    "primary": "orders per person assigned, counting people who unsubscribe during the test",
    "guardrails": "complaints under 0.10% and unsubscribes per send at most 0.206%, read every two weeks; stop the test arm if it crosses one",
    "size": {
      "p0_orders_per_recipient_per_month_pct": 1.109,
      "p0_over_8_weeks_pct": 2.041,
      "lift_to_detect_pct": 15.0,
      "people_per_arm_needed": 35933,
      "people_per_arm_available": 10850,
      "smallest_detectable_lift_pct": 28.1,
      "smallest_detectable_lift_at_12_weeks_pct": 22.5,
      "math": "n = (1.96 + 0.8416)^2 x (p0(1 - p0) + p1(1 - p1)) / (p1 - p0)^2, p1 = p0 x 1.15; 95% confidence, 80% power",
      "verdict": "Half the active tier is 10,850 people, short of the 35,933 needed for a 15% lift. In 8 weeks the test can detect a lift of about 28%, or about 23% if it runs 12 weeks. Pick one before it starts, and don't read the result early."
    }
  },
