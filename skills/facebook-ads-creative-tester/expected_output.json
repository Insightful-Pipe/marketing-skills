  "success_criteria": {
    "table": [
      {
        "outcome": "Winner",
        "when": "p < 0.05 and lift >= 20%",
        "action": "keep the winner, pause the other, log the learning"
      },
      {
        "outcome": "Real but small",
        "when": "p < 0.05 and 0 < lift < 20%",
        "action": "keep either; test a bigger change next"
      },
      {
        "outcome": "Leaning",
        "when": "0.05 <= p < 0.10 and lift >= 20%",
        "action": "extend once by up to 50% more sample, then decide"
      },
      {
        "outcome": "No difference",
        "when": "p >= 0.10",
        "action": "format doesn't move CTR at this size; test the first line or image next"
      },
      {
        "outcome": "Loser",
        "when": "p < 0.05 and the video is worse",
        "action": "stop the video and log why"
      }
    ],
    "guardrail": "When both variants have 30 or more results, the winner's cost per result may be at most 20% worse than the other's.",
    "rules_during_test": [
      "no budget, targeting, copy or creative changes",
      "no pausing and restarting",
      "no new variants",
      "no verdict before day 7",
      "log outside events"
    ]
  },
