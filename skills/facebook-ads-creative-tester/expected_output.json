      "not_a_test": "both ads in one ad set (Meta would favour one within days)"
    }
  },
  "success_criteria": {
    "table": [
      {
        "outcome": "Winner",
        "when": "p < 0.05 and lift >= 20%",
        "action": "keep the winner, pause the other, log the learning"
      },
      {
        "outcome": "Real but small",
        "when": "p < 0.05 and 0 < lift < 20%",
        "action": "keep either; test a bigger change next"
      },
      {
        "outcome": "Leaning",
        "when": "0.05 <= p < 0.10 and lift >= 20%",
        "action": "extend once by up to 50% more sample, then decide"
      },
      {
        "outcome": "No difference",
        "when": "p >= 0.10",
        "action": "the opening doesn't move hook rate at this size; test the body next"
      },
      {
        "outcome": "Loser",
        "when": "p < 0.05 and B is worse",
        "action": "stop B and log why it lost"
      }
    ],
    "guardrail": "With 30 or more purchases per variant, the winner's cost per purchase must be no more than 20% worse than the other's.",
    "rules": [
      "no budget, targeting, copy or creative changes",
      "no pausing and restarting",
      "no new variants",
      "no verdict before day 7"
    ]
  },
