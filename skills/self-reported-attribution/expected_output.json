  "question_audit": {
    "existing_question": "How did you hear about us?",
    "checks": [
      {
        "check": "Answer order",
        "result": "flag",
        "finding": "The order is fixed and \"Facebook or Instagram\" is always first. Its 19.6% share can't be separated from first-position picks, so read it as an upper bound.",
        "fix": "Randomise the options and pin \"Other (tell us)\" last."
      },
      {
        "check": "Discovery wording",
        "result": "flag",
        "finding": "\"How did you hear about us?\" has no \"first\", so people name the latest step, often a Google search.",
        "fix": "Ask \"Where did you first hear about Example Coffee?\""
      },
      {
        "check": "Missing channels",
        "result": "flag",
        "finding": "AI assistant is 3.4% of coded answers with no option of its own; Reddit or online community is 4.6% of coded answers with no option of its own",
        "fix": "Add \"An AI assistant (ChatGPT, Gemini, Perplexity or similar)\" and \"Reddit or an online community\"."
      },
      {
        "check": "Unclear labels",
        "result": "flag",
        "finding": "18 of 99 \"Other\" texts (18.2%) name a channel that is already listed.",
        "fix": "Rename the options people retyped most, in customers' words: \"Instagram or Facebook\" (5 retyped), \"Google search\" (4 retyped)."
      },
      {
        "check": "Overlapping options",
        "result": "pass",
        "finding": "Each option is one channel.",
        "fix": "None needed."
      },
      {
        "check": "Length",
        "result": "pass",
        "finding": "8 options including Other, within 10.",
        "fix": "None needed."
      },
      {
        "check": "Leading or ad-only wording",
        "result": "pass",
        "finding": "The question doesn't mention ads.",
        "fix": "None needed."
      },
      {
        "check": "Select type and placement",
        "result": "pass",
        "finding": "Single select, optional, after payment.",
        "fix": "None needed."
      }
    ],
