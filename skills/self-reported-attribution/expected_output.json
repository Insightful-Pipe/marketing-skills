  "findings": [
    {
      "title": "Direct hides word of mouth, Instagram and Facebook, and podcasts",
      "evidence": "Of 138 coded respondents GA4 files under Direct first touch, 26.8% said Friend, family or colleague, 15.9% said Instagram or Facebook, 15.9% said Podcast.",
      "so_what": "Direct is where the untracked channels land. Read it as demand made elsewhere, not as a channel of its own."
    },
    {
      "title": "Podcasts bring bigger orders and GA4 can barely see them",
      "evidence": "Podcast is 10.9% of customers (range 7.9 to 13.9%) and 15.0% of revenue; GA4 traces 0.9% of first orders to a podcast, and 94.9% of podcast answers show no podcast source in GA4.",
      "so_what": "GA4 would rate the sponsorships near zero, while respondents tie 15.0% of first-order revenue to them. Keep them, and add a show-specific code or link to each read."
    },
    {
      "title": "AI assistants and Reddit are real channels the list doesn't offer",
      "evidence": "AI assistant 3.4% (range 1.6 to 5.1%) and Reddit or online community 4.6% (range 2.6 to 6.6%), all from free text; GA4 sees 2.3% and 1.6%.",
      "so_what": "Add both options so they are counted without relying on people typing."
    },
    {
      "title": "Meta claims more than customers name, and GA4 sees less",
