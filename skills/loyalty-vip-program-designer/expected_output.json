  "findings": [
    {
      "finding": "Gold is too easy to reach and never resets",
      "evidence": "Gold needs $250 of lifetime spend, so 35.7% of members are Gold (up from 16.4% a year ago) and 0 members moved down in 12 months. Only 8.1% of customers spend $250 in a year."
    },
    {
      "finding": "The program gives back more than the margin budget",
      "evidence": "At face value it returns 8.1% of member spend against a budget of 6.2% (10% of a 62% margin). Measured redemption of 37.5% keeps the real cost at 3.03%, so what closes the gap is breakage, not the design."
    },
    {
      "finding": "Points are a liability on the books",
      "evidence": "123,142 points are outstanding: $6,157.10 at face, $2,311.52 at the measured redemption rate."
    },
    {
      "finding": "The top customers have no tier of their own",
      "evidence": "The top 5% of customers bring 21.9% of revenue and start at $295.97 a year, but earn the same as a $250 lifetime customer."
    }
  ],
