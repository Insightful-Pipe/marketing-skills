    "central_idea_options": [
      {
        "idea": "An empty chair costs more than a reminder.",
        "recommended": true,
        "why": "Puts the cost of the no-show first, which is what owners already feel; every channel can show the empty chair."
      },
      {
        "idea": "Your calendar, kept.",
        "recommended": false,
        "why": "Shorter, but says less about the problem the features solve."
      }
