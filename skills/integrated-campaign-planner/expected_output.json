    "message": "Reminders and deposits that stop no-shows before they happen.",
    "proof_points": [
      "Automatic SMS and email reminders go out 24 hours and 2 hours before each booking",
      "Deposits are taken at booking and kept when a client doesn't show, under the business's own policy",
      "Clients reschedule from the reminder link instead of just not turning up"
    ],
    "call_to_action": {
      "action": "Start using reminders",
      "page": "https://www.example.com/features/reminders/",
      "utm_campaign": "noshow27"
