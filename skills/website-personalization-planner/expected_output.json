  "plan": [
    {
      "key": "clinics",
      "group": "Search | Clinic scheduling",
      "family": "campaign",
      "precedence": 1,
      "why_this_group": "1.29% of sessions sign up against 4.11% for the rest of the page (-68.5%, z -13.01); about 83.5 sign-ups a month lost. The page speaks to salons first; these visitors searched for clinic and patient scheduling.",
      "copy": {
        "headline": {
          "default": "Online booking software for small businesses",
          "variant": "Clinic scheduling software patients book themselves",
          "characters": 51,
          "limit": 59,
          "source": "top search term \"clinic scheduling software\" (1410 of 6180 clicks)"
        },
        "subhead": {
          "default": "Let clients book and pay online 24/7, and cut no-shows with automatic reminders.",
          "variant": "Patient self scheduling and online booking for physiotherapy and medical clinics, with automatic reminders that cut no-shows.",
          "source": "search terms \"patient self scheduling\" (410 clicks) and \"online booking for physiotherapy clinic\" (760 clicks)"
        },
        "offer": {
          "default": "Plans from $19 a month",
          "variant": "Our setup team moves your patient list and calendar over in one day (Growth and Business plans)",
          "source": "your setup offer for clinics"
        },
        "proof": {
          "default": "Rated 4.8 out of 5 from 2,300 reviews",
          "variant": "Example Physio Clinic cut no-shows from 14% to 5% in three months",
          "source": "your proof library, tagged clinics"
        },
        "cta": {
          "default": "Create your account",
          "variant": "Set up your clinic calendar",
          "source": "your CTA for clinics"
        }
      },
      "targeting": {
        "method": "URL parameter",
        "rule": "show when the URL has pz=clinics; any other or missing value shows the default page",
        "how_the_parameter_gets_there": "append &pz=clinics to the campaign's final URL suffix (payload below, not run)",
        "dynamic_text": "lookup only: the parameter picks one of the approved texts above and is never written into the page"
      },
      "test": {
        "holdout_pct": 20,
        "split": "80% see the variant, 20% see the default page",
        "sized_on": "every session from the campaign",
        "baseline_rate_pct": 1.29,
        "target_rate_pct": 2.7,
        "weekly_sessions": 692,
        "sessions_needed": 3821,
        "weeks": 6,
        "options_checked": [
          {
            "holdout_pct": 10,
            "sessions_needed": 6198,
            "weeks": 9
          },
          {
            "holdout_pct": 20,
            "sessions_needed": 3821,
            "weeks": 6
          },
          {
            "holdout_pct": 30,
            "sessions_needed": 3166,
            "weeks": 5
          },
          {
            "holdout_pct": 50,
            "sessions_needed": 3087,
            "weeks": 5
          }
        ],
        "assignment": "random per visitor, kept in a first-party cookie so a returning visitor stays in the same arm",
        "measure": "GA4 event parameter pz_variant = clinics:variant or clinics:holdout on page_view; read sessionKeyEventRate:sign_up by customEvent:pz_variant",
        "decision": "after 6 weeks, keep the variant for this group only if it beats the holdout at 95% confidence; otherwise this group goes back to the default page"
      }
    },
    {
